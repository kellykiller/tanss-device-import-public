TANSS_BASE_URL=https://tanss.example.org/backend
TANSS_DEVICE_WEB_URL_TEMPLATE=https://tanss.example.org/devices/{deviceId}

IMPORT_API_BIND_ADDRESS=127.0.0.1
IMPORT_API_HTTPS_PORT=45001
IMPORT_API_HEALTH_PORT=8080
IMPORT_API_SECRETS_PATH=./secrets

SAP_ENABLED=false
SAP_SERVER=sql.example.org
SAP_PORT=1433
SAP_DATABASE=SAP_DATABASE_NAME
SAP_USER_NAME=sap_readonly_user
SAP_TRUST_SERVER_CERTIFICATE=false
