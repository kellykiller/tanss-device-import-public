#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

if (( EUID != 0 )); then
    echo "Fehler: Dieses Skript muss als root ausgeführt werden." >&2
    exit 1
fi

script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
server_directory="$(cd -- "$script_directory/.." && pwd -P)"
source "$script_directory/runtime-paths"

secret_directory="$(
    tdi_resolve_setting \
        IMPORT_API_SECRETS_PATH \
        "$server_directory/.env" \
        "/opt/tanss-device-import/secrets"
)"
tdi_require_absolute_path "$secret_directory" "IMPORT_API_SECRETS_PATH"
secret_file="$secret_directory/totp_secret"
action="${1:-}"
issuer="TANSS Device Import"
account="TANSS Import"

for required_command in openssl base32 install mktemp chown; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        echo "Fehler: Benötigter Befehl nicht gefunden: $required_command" >&2
        exit 1
    fi
done

usage() {
    echo "Verwendung:" >&2
    echo "  $0 create" >&2
    echo "  $0 rotate" >&2
    echo "  $0 status" >&2
}

show_enrollment() {
    local secret="$1"
    local uri
    uri="otpauth://totp/TANSS%20Device%20Import:TANSS%20Import?secret=${secret}&issuer=TANSS%20Device%20Import&algorithm=SHA1&digits=6&period=30"

    echo
    echo "TOTP wurde eingerichtet. Den folgenden Schlüssel jetzt in der Authenticator-App hinterlegen:"
    echo
    echo "Anbieter: ${issuer}"
    echo "Kontoname: ${account}"
    echo "Geheimer Schlüssel: ${secret}"
    echo "Typ: zeitbasiert (TOTP), SHA1, 6 Stellen, 30 Sekunden"
    echo
    echo "Einrichtungs-URI:"
    echo "$uri"

    if command -v qrencode >/dev/null 2>&1; then
        echo
        echo "QR-Code:"
        qrencode -t ANSIUTF8 "$uri"
    fi

    echo
    echo "Wichtig: Der geheime Schlüssel wird für Wiederherstellung oder ein zweites Gerät benötigt."
    echo "Er darf nicht in Tickets, Protokollen oder dem Client gespeichert werden."
}

write_new_secret() {
    local allow_overwrite="$1"
    local temporary_file
    local secret

    if [[ -e "$secret_file" && "$allow_overwrite" != "true" ]]; then
        echo "Fehler: TOTP ist bereits eingerichtet. Für einen bewussten Austausch 'rotate' verwenden." >&2
        exit 1
    fi

    install -d -m 0710 "$secret_directory"
    chown 0:1654 "$secret_directory"
    temporary_file="$(mktemp "$secret_directory/.totp_secret.XXXXXX")"

    cleanup() {
        rm -f -- "$temporary_file"
    }

    trap cleanup EXIT

    secret="$(openssl rand 20 | base32 | tr -d '=\r\n')"
    printf '%s\n' "$secret" >"$temporary_file"
    install -m 0400 "$temporary_file" "$secret_file"
    chown 1654:1654 "$secret_file"

    trap - EXIT
    rm -f -- "$temporary_file"

    if [[ "$allow_overwrite" == "true" ]] &&
       /usr/bin/docker inspect \
           --format '{{.State.Running}}' \
           tanss-device-import-api 2>/dev/null |
           grep -qx 'true'; then
        /usr/bin/docker compose \
            --project-directory "$server_directory" \
            -f "$server_directory/compose.yaml" \
            restart import-api
    fi

    show_enrollment "$secret"
}

case "$action" in
    create)
        write_new_secret false
        ;;
    rotate)
        echo "Hinweis: Alle bestehenden TOTP-App-Einträge und Importdienst-Sitzungen werden ungültig."
        read -r -p "TOTP-Schlüssel wirklich ersetzen? [ja/NEIN] " confirmation

        if [[ "$confirmation" != "ja" ]]; then
            echo "Abgebrochen."
            exit 1
        fi

        write_new_secret true
        ;;
    status)
        if [[ ! -f "$secret_file" ]]; then
            echo "TOTP_STATUS=not_configured"
            exit 1
        fi

        stat -c 'Path=%n Owner=%u Group=%g Mode=%a Size=%s' "$secret_file"
        echo "TOTP_STATUS=configured"
        ;;
    *)
        usage
        exit 1
        ;;
esac
