<Window x:Class="TanssSystemCapture.Client.CustomerSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TANSS Systemerfassung · Anmeldung" Width="480" Height="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
<StackPanel Margin="36"><TextBlock Text="TANSS Systemerfassung" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Mit dem Importdienst verbinden" Margin="0,8,0,28" Foreground="{DynamicResource SecondaryTextBrush}"/>
<TextBlock Text="Server-URL" Margin="0,0,0,8"/><TextBox x:Name="ServerAddressTextBox" Height="38" Padding="9" TextChanged="Input_OnChanged"/>
<TextBlock Text="TOTP-Code" Margin="0,22,0,8"/><PasswordBox x:Name="TotpCodePasswordBox" Height="38" Padding="9" MaxLength="6" PasswordChanged="Input_OnChanged"/>
<Button x:Name="ContinueButton" Content="Anmelden" Height="40" Margin="0,24,0,0" IsDefault="True" IsEnabled="False" Click="ContinueButton_OnClick"/><TextBlock x:Name="StatusTextBlock" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
</StackPanel></Window>