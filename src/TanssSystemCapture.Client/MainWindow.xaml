<Window x:Class="TanssSystemCapture.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TANSS Systemerfassung"
        Width="1080"
        Height="820"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="MainWindow_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="TANSS Systemerfassung"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Dark Mode"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="ThemeToggleButton"
                              Style="{StaticResource ThemeToggleStyle}"
                              IsChecked="True"
                              ToolTip="Zwischen dunkler und heller Darstellung wechseln"
                              Checked="ThemeToggleButton_OnToggled"
                              Unchecked="ThemeToggleButton_OnToggled" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Kunde:"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="CustomerTextBlock"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Kunde ändern"
                        Width="125"
                        Height="32"
                        Margin="16,0,0,0"
                        Click="ChangeCustomerButton_OnClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lokale Systemerfassung"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RefreshCaptureButton"
                                    Grid.Column="1"
                                    Content="Neu erfassen"
                                    Width="120"
                                    Height="32"
                                    Click="RefreshCaptureButton_OnClick" />
                        </Grid>

                        <TextBlock x:Name="CaptureStatusTextBlock"
                                   Grid.Row="1"
                                   Margin="0,10,0,0"
                                   Text="Systemdaten werden erfasst."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Erfasster Hostname:"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CapturedHostnameTextBlock"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Vorgesehene Übertragungswerte"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Optionale Felder können einzeln abgewählt werden; alle Werte bleiben direkt bearbeitbar. Das Modell ist ein Pflichtfeld. Mehrere Netzwerkadapter können gleichzeitig ausgewählt werden."
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Alles zurücksetzen"
                                    Width="145"
                                    Height="32"
                                    Margin="16,0,0,0"
                                    Click="ResetTransferFieldsButton_OnClick" />
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SendHostnameCheckBox"
                                          VerticalAlignment="Center"
                                          Checked="TransferSelection_OnChanged"
                                          Unchecked="TransferSelection_OnChanged" />
                                <TextBlock Grid.Column="1"
                                           Text="Hostname"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="TransferHostnameTextBox"
                                         Grid.Column="2"
                                         Height="30"
                                         Padding="6,3"
                                         TextChanged="TransferSelection_OnTextChanged"
                                         IsEnabled="{Binding IsChecked, ElementName=SendHostnameCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendModelCheckBox"
                                              IsChecked="True"
                                              IsEnabled="False"
                                              ToolTip="Das TANSS-Pflichtfeld Modell wird immer übertragen."
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Modell *"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferModelTextBox"
                                             Grid.Column="2"
                                             Height="30"
                                             Padding="6,3"
                                             MaxLength="255"
                                             TextChanged="TransferSelection_OnTextChanged" />
                                </Grid>
                                <TextBlock x:Name="ModelDetectionTextBlock"
                                           Margin="226,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendManufacturerCheckBox"
                                              VerticalAlignment="Center"
                                              IsEnabled="False"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="Hersteller"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="ManufacturerComboBox"
                                              Grid.Column="2"
                                              Height="30"
                                              Padding="5,2"
                                              DisplayMemberPath="Name"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              IsTextSearchCaseSensitive="False"
                                              StaysOpenOnEdit="True"
                                              TextSearch.TextPath="Name"
                                              IsEnabled="{Binding IsChecked, ElementName=SendManufacturerCheckBox}"
                                              SelectionChanged="TransferSelection_OnChanged" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendOperatingSystemCheckBox"
                                              VerticalAlignment="Center"
                                              IsEnabled="False"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="Betriebssystem"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="OperatingSystemComboBox"
                                              Grid.Column="2"
                                              Height="30"
                                              Padding="5,2"
                                              DisplayMemberPath="Name"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              IsTextSearchCaseSensitive="False"
                                              StaysOpenOnEdit="True"
                                              TextSearch.TextPath="Name"
                                              IsEnabled="{Binding IsChecked, ElementName=SendOperatingSystemCheckBox}"
                                              SelectionChanged="TransferSelection_OnChanged" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="165" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendArticleNumberCheckBox"
                                              VerticalAlignment="Center"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="SAP-Artikel-Nr."
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferArticleNumberTextBox"
                                             Grid.Column="2"
                                             Height="30"
                                             Margin="0,0,10,0"
                                             Padding="6,3"
                                             MaxLength="255"
                                             IsEnabled="{Binding IsChecked, ElementName=SendArticleNumberCheckBox}"
                                             TextChanged="TransferArticleNumberTextBox_OnTextChanged" />
                                    <Button x:Name="LookupSapArticleNumberButton"
                                            Grid.Column="3"
                                            Height="30"
                                            Content="In SAP suchen"
                                            Click="LookupSapArticleNumberButton_OnClick" />
                                </Grid>

                                <TextBlock x:Name="SapArticleNumberStatusTextBlock"
                                           Margin="226,7,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <TextBlock x:Name="DeviceCatalogStatusTextBlock"
                                           Margin="226,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Hersteller und Betriebssysteme werden aus TANSS geladen."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="165" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendSerialNumberCheckBox"
                                              VerticalAlignment="Center"
                                              Checked="SendSerialNumberCheckBox_OnChanged"
                                              Unchecked="SendSerialNumberCheckBox_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="Seriennummer"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferSerialNumberTextBox"
                                             Grid.Column="2"
                                             Height="30"
                                             Margin="0,0,10,0"
                                             Padding="6,3"
                                             MaxLength="200"
                                             IsEnabled="{Binding IsChecked, ElementName=SendSerialNumberCheckBox}"
                                             TextChanged="TransferSerialNumberTextBox_OnTextChanged" />
                                    <Button x:Name="ValidateSerialNumberButton"
                                            Grid.Column="3"
                                            Height="30"
                                            Content="Seriennummer prüfen"
                                            IsEnabled="{Binding IsChecked, ElementName=SendSerialNumberCheckBox}"
                                            Click="ValidateSerialNumberButton_OnClick" />
                                </Grid>
                                <TextBlock x:Name="SerialNumberDetectionTextBlock"
                                           Margin="226,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="SerialNumberValidationStatusTextBlock"
                                           Margin="226,7,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendTeamViewerIdCheckBox"
                                              VerticalAlignment="Center"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="TeamViewer-ID"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferTeamViewerIdTextBox"
                                             Grid.Column="2"
                                             Height="30"
                                             Padding="6,3"
                                             TextChanged="TransferSelection_OnTextChanged"
                                             IsEnabled="{Binding IsChecked, ElementName=SendTeamViewerIdCheckBox}" />
                                </Grid>
                                <TextBlock x:Name="TeamViewerDetectionTextBlock"
                                           Margin="226,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SendRemarkCheckBox"
                                          VerticalAlignment="Top"
                                          Margin="0,7,0,0"
                                          Checked="TransferSelection_OnChanged"
                                          Unchecked="TransferSelection_OnChanged" />
                                <TextBlock Grid.Column="1"
                                           Text="Bemerkung"
                                           VerticalAlignment="Top"
                                           Margin="0,7,0,0" />
                                <TextBox x:Name="TransferRemarkTextBox"
                                         Grid.Column="2"
                                         MinHeight="70"
                                         Padding="6"
                                         MaxLength="10000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="TransferSelection_OnTextChanged"
                                         IsEnabled="{Binding IsChecked, ElementName=SendRemarkCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SendInternalRemarkCheckBox"
                                              VerticalAlignment="Top"
                                              Margin="0,7,0,0"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="Interne Bemerkung / Passwort"
                                               VerticalAlignment="Top"
                                               Margin="0,7,10,0"
                                               TextWrapping="Wrap" />
                                    <TextBox x:Name="TransferInternalRemarkTextBox"
                                             Grid.Column="2"
                                             MinHeight="70"
                                             Padding="6"
                                             MaxLength="10000"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             TextChanged="TransferSelection_OnTextChanged"
                                             IsEnabled="{Binding IsChecked, ElementName=SendInternalRemarkCheckBox}" />
                                </Grid>
                                <TextBlock Margin="226,6,0,0"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Nur aktivieren, wenn der Inhalt wirklich in der geschützten internen TANSS-Bemerkung gespeichert werden soll." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="IsVirtualMachineCheckBox"
                                          Content="Das erfasste System ist eine virtuelle Maschine"
                                          FontWeight="SemiBold"
                                          Checked="IsVirtualMachineCheckBox_OnChanged"
                                          Unchecked="IsVirtualMachineCheckBox_OnChanged" />

                                <StackPanel Margin="26,8,0,0"
                                            IsEnabled="{Binding IsChecked, ElementName=IsVirtualMachineCheckBox}">
                                    <Grid x:Name="VmHostInputGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SendVmHostIdCheckBox"
                                                  VerticalAlignment="Center"
                                                  Checked="SendVmHostIdCheckBox_OnChanged"
                                                  Unchecked="SendVmHostIdCheckBox_OnChanged" />
                                        <TextBlock Grid.Column="1"
                                                   Text="TANSS-ID des VM-Hosts"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="TransferVmHostIdTextBox"
                                                 Grid.Column="2"
                                                 Height="30"
                                                 Margin="0,0,10,0"
                                                 Padding="6,3"
                                                 IsEnabled="{Binding IsChecked, ElementName=SendVmHostIdCheckBox}"
                                                 TextChanged="TransferVmHostIdTextBox_OnTextChanged" />
                                        <Button x:Name="ValidateVmHostButton"
                                                Grid.Column="3"
                                                Height="30"
                                                Content="Host prüfen"
                                                IsEnabled="{Binding IsChecked, ElementName=SendVmHostIdCheckBox}"
                                                Click="ValidateVmHostButton_OnClick" />
                                    </Grid>

                                    <TextBlock x:Name="HostValidationStatusTextBlock"
                                               Margin="256,7,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock x:Name="VirtualMachineDetectionTextBlock"
                                           Margin="26,9,0,0"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <CheckBox x:Name="IsServerCheckBox"
                                      Content="Das erfasste System ist ein Server"
                                      FontWeight="SemiBold"
                                      Checked="TransferSelection_OnChanged"
                                      Unchecked="TransferSelection_OnChanged" />
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Garantie"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Button x:Name="LookupWortmannWarrantyButton"
                                            Grid.Column="1"
                                            Width="210"
                                            Height="30"
                                            Content="Wortmann-Garantie abfragen"
                                            Click="LookupWortmannWarrantyButton_OnClick" />
                                </Grid>
                                <TextBlock Margin="0,4,0,10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Datumswerte werden im TANSS-Anzeigeformat ddMMyy eingegeben. Jedes Feld kann einzeln übertragen werden; Gewährleistungsdaten werden nicht verwendet." />

                                <TextBlock x:Name="WortmannWarrantyStatusTextBlock"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="SendPurchaseDateCheckBox"
                                              VerticalAlignment="Center"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Column="1"
                                               Text="Kaufdatum"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferPurchaseDateTextBox"
                                             Grid.Column="2"
                                             Height="30"
                                             Padding="6,3"
                                             MaxLength="6"
                                             ToolTip="Format ddMMyy, zum Beispiel 040725"
                                             IsEnabled="{Binding IsChecked, ElementName=SendPurchaseDateCheckBox}"
                                             TextChanged="TransferSelection_OnTextChanged" />

                                    <CheckBox x:Name="SendGuaranteeMonthCheckBox"
                                              Grid.Row="1"
                                              Margin="0,8,0,0"
                                              VerticalAlignment="Center"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               Text="Garantiedauer (Monate)"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferGuaranteeMonthTextBox"
                                             Grid.Row="1"
                                             Grid.Column="2"
                                             Height="30"
                                             Margin="0,8,0,0"
                                             Padding="6,3"
                                             MaxLength="4"
                                             IsEnabled="{Binding IsChecked, ElementName=SendGuaranteeMonthCheckBox}"
                                             TextChanged="TransferSelection_OnTextChanged" />

                                    <CheckBox x:Name="SendGuaranteeExpireCheckBox"
                                              Grid.Row="2"
                                              Margin="0,8,0,0"
                                              VerticalAlignment="Center"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               Text="Garantieablaufdatum"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TransferGuaranteeExpireTextBox"
                                             Grid.Row="2"
                                             Grid.Column="2"
                                             Height="30"
                                             Margin="0,8,0,0"
                                             Padding="6,3"
                                             MaxLength="6"
                                             ToolTip="Format ddMMyy, zum Beispiel 040728"
                                             IsEnabled="{Binding IsChecked, ElementName=SendGuaranteeExpireCheckBox}"
                                             TextChanged="TransferSelection_OnTextChanged" />

                                    <CheckBox x:Name="SendGuaranteeRemarkCheckBox"
                                              Grid.Row="3"
                                              Margin="0,8,0,0"
                                              VerticalAlignment="Top"
                                              Checked="TransferSelection_OnChanged"
                                              Unchecked="TransferSelection_OnChanged" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Margin="0,15,0,0"
                                               Text="Garantiebemerkung"
                                               VerticalAlignment="Top" />
                                    <TextBox x:Name="TransferGuaranteeRemarkTextBox"
                                             Grid.Row="3"
                                             Grid.Column="2"
                                             MinHeight="55"
                                             Margin="0,8,0,0"
                                             Padding="6"
                                             MaxLength="10000"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             IsEnabled="{Binding IsChecked, ElementName=SendGuaranteeRemarkCheckBox}"
                                             TextChanged="TransferSelection_OnTextChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Netzwerkadapter"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,0" />
                        <TextBlock Text="Mit dem Haken vor dem Adapternamen wird der gesamte Adapter ein- oder ausgeschlossen. Innerhalb jedes Adapters lassen sich die Felder zusätzlich einzeln steuern."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <ItemsControl x:Name="NetworkAdapterItemsControl"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,8,0,0"
                                            Padding="12"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{Binding Header}"
                                                      FontWeight="SemiBold" />

                                            <TextBlock Text="{Binding TechnicalDetails}"
                                                       Margin="26,5,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WarningText}"
                                                       Margin="26,4,0,0"
                                                       Foreground="{DynamicResource WarningTextBrush}"
                                                       TextWrapping="Wrap" />

                                            <Grid Margin="26,10,0,0"
                                                  IsEnabled="{Binding IsSelected}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Aktiv"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Feld"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Grid.Column="2"
                                                           Text="Vorgesehener Wert"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,5" />

                                                <CheckBox Grid.Row="1"
                                                          IsChecked="{Binding SendAdapterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="Adapterbezeichnung"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Row="1"
                                                         Grid.Column="2"
                                                         Height="30"
                                                         Padding="6,3"
                                                         Text="{Binding TransferAdapterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding SendAdapterName}" />

                                                <CheckBox Grid.Row="2"
                                                          Margin="0,8,0,0"
                                                          IsChecked="{Binding SendMacAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           Text="MAC-Adresse"
                                                           Margin="0,8,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2"
                                                         Grid.Column="2"
                                                         Height="30"
                                                         Margin="0,8,0,0"
                                                         Padding="6,3"
                                                         Text="{Binding TransferMacAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding SendMacAddress}" />

                                                <CheckBox Grid.Row="3"
                                                          Margin="0,8,0,0"
                                                          IsChecked="{Binding SendIpv4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanSelectIpv4}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           Text="Statische IPv4-Adresse"
                                                           Margin="0,8,0,0"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Row="3"
                                                         Grid.Column="2"
                                                         Height="30"
                                                         Margin="0,8,0,0"
                                                         Padding="6,3"
                                                         Text="{Binding TransferIpv4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding SendIpv4}" />

                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="1"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,6,0,0"
                                                           Text="{Binding Ipv4Hint}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoAdaptersTextBlock"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Text="Es stehen keine Netzwerkadapter zur Auswahl."
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="16"
                        Background="{DynamicResource DangerBackgroundBrush}"
                        BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Prüft die Eingaben sicher im Hintergrund und überträgt das System nach Ihrer Bestätigung nach TANSS." />
                        <Button x:Name="CreateDeviceButton" Grid.Column="1"
                                Width="210" Height="36" Margin="16,0,0,0"
                                Content="System nach TANSS übertragen"
                                Click="CreateDeviceButton_OnClick" />
                    </Grid>
                </Border>

                <TextBlock x:Name="DeviceCreationStatusTextBlock" Margin="0,10,0,0"
                           FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />

                <Border x:Name="CreatedDeviceIdBorder" Margin="0,12,0,0" Padding="12"
                        Background="{DynamicResource SuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Text="TANSS-System:" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Hyperlink x:Name="CreatedDeviceHyperlink"
                                       RequestNavigate="CreatedDeviceHyperlink_OnRequestNavigate">
                                <Run x:Name="CreatedDeviceLinkRun" />
                            </Hyperlink>
                        </TextBlock>
                        <Button Grid.Column="2" Width="115" Height="32" Margin="10,0,0,0"
                                Content="Link kopieren" Click="CopyCreatedDeviceLinkButton_OnClick" />
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0" Padding="16"
                        BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource InfoBackgroundBrush}">
                    <Expander x:Name="TransferPreviewExpander" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="Optionale JSON-/Übertragungsvorschau"
                                       FontSize="16" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="Zeigt die serverseitig geprüfte Feldzuordnung und die geplante JSON-Nutzlast. Es wird dabei nichts gespeichert." />
                                <Button x:Name="CreateTransferPreviewButton" Grid.Column="1"
                                        Width="205" Height="34" Margin="16,0,0,0"
                                        Content="Optionale Vorschau erstellen"
                                        Click="CreateTransferPreviewButton_OnClick" />
                            </Grid>
                            <TextBlock x:Name="TransferPreviewStatusTextBlock" Margin="0,12,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <TextBox x:Name="TransferPreviewTextBox" Margin="0,10,0,0"
                                     MinHeight="210" Padding="10" FontFamily="Consolas" FontSize="12"
                                     IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3"
                Content="Schließen"
                Width="110"
                Height="34"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Click="CloseButton_OnClick" />
    </Grid>
</Window>
