<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TanssSystemCapture.Client.MainWindow" Title="TANSS Systemerfassung · 1.0.1" Width="1380" Height="820" MinWidth="1180" MinHeight="640" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Loaded="MainWindow_OnLoaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="TANSS Systemerfassung" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Text="GERÄTEIMPORT  ·  1.0.1" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
      <Grid x:Name="CustomerInputPanel">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Kundennummer" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBox x:Name="CustomerNumberTextBox" Height="34" Padding="8" ToolTip="Kundennummer" />
        </StackPanel>
        <Button Grid.Column="1" Content="Kunde auswählen" Margin="10,0,0,0" Click="ChangeCustomerButton_OnClick" VerticalAlignment="Bottom" Height="34" />
        <StackPanel Grid.Column="2" Margin="18,0,0,0">
          <TextBlock x:Name="CustomerTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="CustomerStatusTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Lokale Systemerfassung" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="RefreshCaptureButton" Grid.Column="1" Content="Neu erfassen" Width="120" Height="32" Click="RefreshCaptureButton_OnClick" />
            </Grid>
            <TextBlock x:Name="CaptureStatusTextBlock" Grid.Row="1" Margin="0,10,0,0" Text="Systemdaten werden erfasst." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Erfasster Hostname:" VerticalAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="CapturedHostnameTextBlock" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </Grid>
        </Border>
        <Grid x:Name="TransferFieldsPanel" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="System &amp; Zuordnung" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
            <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="145" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SendHostnameCheckBox" VerticalAlignment="Center" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                <TextBlock Grid.Column="1" Text="Hostname" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox x:Name="TransferHostnameTextBox" Grid.Column="2" Height="30" Padding="6,3" TextChanged="TransferSelection_OnTextChanged" />
              </Grid>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="165" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendModelCheckBox" IsChecked="True" IsEnabled="False" ToolTip="Das TANSS-Pflichtfeld Modell wird immer übertragen." VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Modell *" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferModelTextBox" Grid.Column="2" Height="60" Margin="0,0,10,0" Padding="6,3" MaxLength="255" TextChanged="TransferModelTextBox_OnTextChanged" TextWrapping="Wrap" VerticalContentAlignment="Center" />
                  <Button x:Name="LookupWortmannModelButton" Grid.Column="3" Height="30" Content="Bei Wortmann suchen" Click="LookupWortmannModelButton_OnClick" />
                </Grid>
                <TextBlock x:Name="ModelDetectionTextBlock" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendManufacturerCheckBox" VerticalAlignment="Center" IsEnabled="False" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Column="1" Text="Hersteller" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ComboBox x:Name="ManufacturerComboBox" Grid.Column="2" Height="30" Padding="5,2" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" StaysOpenOnEdit="True" TextSearch.TextPath="Name" IsEnabled="{Binding IsChecked, ElementName=SendManufacturerCheckBox}" SelectionChanged="TransferSelection_OnChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendOperatingSystemCheckBox" VerticalAlignment="Center" IsEnabled="False" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Column="1" Text="Betriebssystem" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ComboBox x:Name="OperatingSystemComboBox" Grid.Column="2" Height="30" Padding="5,2" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" StaysOpenOnEdit="True" TextSearch.TextPath="Name" IsEnabled="{Binding IsChecked, ElementName=SendOperatingSystemCheckBox}" SelectionChanged="TransferSelection_OnChanged" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="165" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendArticleNumberCheckBox" VerticalAlignment="Center" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Column="1" Text="SAP-Artikel-Nr." VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferArticleNumberTextBox" Grid.Column="2" Height="30" Margin="0,0,10,0" Padding="6,3" MaxLength="255" IsEnabled="{Binding IsChecked, ElementName=SendArticleNumberCheckBox}" TextChanged="TransferArticleNumberTextBox_OnTextChanged" />
                  <Button x:Name="LookupSapArticleNumberButton" Grid.Column="3" Height="30" Content="In SAP suchen" Click="LookupSapArticleNumberButton_OnClick" />
                </Grid>
                <TextBlock x:Name="SapArticleNumberStatusTextBlock" Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="DeviceCatalogStatusTextBlock" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Hersteller und Betriebssysteme werden aus TANSS geladen." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="165" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendSerialNumberCheckBox" VerticalAlignment="Center" Checked="SendSerialNumberCheckBox_OnChanged" Unchecked="SendSerialNumberCheckBox_OnChanged" />
                  <TextBlock Grid.Column="1" Text="Seriennummer" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferSerialNumberTextBox" Grid.Column="2" Height="30" Margin="0,0,10,0" Padding="6,3" MaxLength="200" TextChanged="TransferSerialNumberTextBox_OnTextChanged" />
                  <Button x:Name="ValidateSerialNumberButton" Grid.Column="3" Height="30" Content="Seriennummer prüfen" Click="ValidateSerialNumberButton_OnClick" />
                </Grid>
                <TextBlock x:Name="SerialNumberDetectionTextBlock" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="SerialNumberValidationStatusTextBlock" Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendTeamViewerIdCheckBox" VerticalAlignment="Center" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Column="1" Text="TeamViewer-ID" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferTeamViewerIdTextBox" Grid.Column="2" Height="30" Padding="6,3" TextChanged="TransferSelection_OnTextChanged" IsEnabled="{Binding IsChecked, ElementName=SendTeamViewerIdCheckBox}" />
                </Grid>
                <TextBlock x:Name="TeamViewerDetectionTextBlock" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="145" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SendRemarkCheckBox" VerticalAlignment="Top" Margin="0,7,0,0" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                <TextBlock Grid.Column="1" Text="Bemerkung" VerticalAlignment="Top" Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBox x:Name="TransferRemarkTextBox" Grid.Column="2" MinHeight="70" Padding="6" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TransferSelection_OnTextChanged" IsEnabled="{Binding IsChecked, ElementName=SendRemarkCheckBox}" />
              </Grid>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="SendInternalRemarkCheckBox" VerticalAlignment="Top" Margin="0,7,0,0" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Column="1" Text="Interne Bemerkung / Passwort" VerticalAlignment="Top" Margin="0,7,10,0" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferInternalRemarkTextBox" Grid.Column="2" MinHeight="70" Padding="6" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TransferSelection_OnTextChanged" IsEnabled="{Binding IsChecked, ElementName=SendInternalRemarkCheckBox}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Padding="12" Margin="0,10,0,0" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8">
              <StackPanel>
                <CheckBox x:Name="SendManufacturerNumberCheckBox" Content="Wortmann-Hersteller-Nr. übertragen" IsChecked="True" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                <TextBox IsEnabled="{Binding IsChecked, ElementName=SendManufacturerNumberCheckBox}" x:Name="TransferManufacturerNumberTextBox" Margin="0,6,0,0" Height="30" TextChanged="TransferSelection_OnTextChanged" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Garantie, Rechnung &amp; Netzwerk" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <CheckBox x:Name="IsServerCheckBox" Content="Das erfasste System ist ein Server" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <CheckBox x:Name="IsVirtualMachineCheckBox" Content="Das erfasste System ist eine virtuelle Maschine" FontWeight="SemiBold" Checked="IsVirtualMachineCheckBox_OnChanged" Unchecked="IsVirtualMachineCheckBox_OnChanged" />
                <StackPanel Margin="26,8,0,0" IsEnabled="{Binding IsChecked, ElementName=IsVirtualMachineCheckBox}">
                  <Grid x:Name="VmHostInputGrid">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="145" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Host-ID (Pflicht bei VM)" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBox x:Name="TransferVmHostIdTextBox" Grid.Column="2" Height="30" Margin="0,0,10,0" Padding="6,3" TextChanged="TransferVmHostIdTextBox_OnTextChanged" />
                    <Button x:Name="ValidateVmHostButton" Grid.Column="3" Height="30" Content="Host prüfen" Click="ValidateVmHostButton_OnClick" />
                  </Grid>
                  <TextBlock x:Name="HostValidationStatusTextBlock" Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="VirtualMachineDetectionTextBlock" Margin="26,9,0,0" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Garantie" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Button x:Name="LookupWortmannWarrantyButton" Grid.Column="1" Width="210" Height="30" Content="Wortmann-Garantie abfragen" Click="LookupWortmannWarrantyButton_OnClick" />
                </Grid>
                <TextBlock Margin="0,4,0,10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Datum: ddMMyy" />
                <TextBlock x:Name="WortmannWarrantyStatusTextBlock" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <CheckBox x:Name="SendPurchaseDateCheckBox" VerticalAlignment="Center" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Column="1" Text="Kaufdatum" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferPurchaseDateTextBox" Grid.Column="2" Height="30" Padding="6,3" MaxLength="6" ToolTip="Format ddMMyy, zum Beispiel 040725" IsEnabled="{Binding IsChecked, ElementName=SendPurchaseDateCheckBox}" TextChanged="TransferSelection_OnTextChanged" />
                  <CheckBox x:Name="SendGuaranteeMonthCheckBox" Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="Garantiedauer (Monate)" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferGuaranteeMonthTextBox" Grid.Row="1" Grid.Column="2" Height="30" Margin="0,8,0,0" Padding="6,3" MaxLength="4" IsEnabled="{Binding IsChecked, ElementName=SendGuaranteeMonthCheckBox}" TextChanged="TransferSelection_OnTextChanged" />
                  <CheckBox x:Name="SendGuaranteeExpireCheckBox" Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="Garantieablaufdatum" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferGuaranteeExpireTextBox" Grid.Row="2" Grid.Column="2" Height="30" Margin="0,8,0,0" Padding="6,3" MaxLength="6" ToolTip="Format ddMMyy, zum Beispiel 040728" IsEnabled="{Binding IsChecked, ElementName=SendGuaranteeExpireCheckBox}" TextChanged="TransferSelection_OnTextChanged" />
                  <CheckBox x:Name="SendGuaranteeRemarkCheckBox" Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Top" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,15,0,0" Text="Garantiebemerkung" VerticalAlignment="Top" TextWrapping="Wrap" />
                  <TextBox x:Name="TransferGuaranteeRemarkTextBox" Grid.Row="3" Grid.Column="2" MinHeight="55" Margin="0,8,0,0" Padding="6" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding IsChecked, ElementName=SendGuaranteeRemarkCheckBox}" TextChanged="TransferSelection_OnTextChanged" />
                </Grid>
              </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="14" Margin="0,12,0,0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" AllowDrop="True" Drop="Invoice_OnDrop">
              <StackPanel>
                <TextBlock Text="Rechnungs-PDF" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="InvoiceStatusTextBlock" Text="PDF-Anhang ausstehend" Margin="0,8,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="AttachInvoiceCheckBox" Content="Nach erfolgreicher Geräteübertragung anhängen" IsChecked="True" Margin="0,10,0,10" Checked="TransferSelection_OnChanged" Unchecked="TransferSelection_OnChanged" />
                <WrapPanel>
                  <Button Content="Erneut suchen" Click="LookupInvoiceButton_OnClick" Padding="10,6" Margin="0,0,8,0" />
                  <Button Content="PDF auswählen" Click="SelectInvoiceButton_OnClick" Padding="10,6" Margin="0,0,8,0" />
                  <Button x:Name="OpenInvoiceButton" Content="PDF öffnen" Click="OpenInvoiceButton_OnClick" IsEnabled="False" Padding="10,6" />
                </WrapPanel>
                <TextBlock Text="PDF hier ablegen" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="Netzwerkadapter" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" TextWrapping="Wrap" />
            <TextBlock Text="Adapter auswählen; DHCP oder statische IPv4 festlegen." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <ItemsControl x:Name="NetworkAdapterItemsControl" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="8" Margin="0,0,0,10" Padding="12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                      <CheckBox Content="{Binding Header}" IsChecked="{Binding IsSelected, Mode=TwoWay}" FontWeight="SemiBold" />
                      <StackPanel IsEnabled="{Binding IsSelected}" Margin="0,10,0,0">
                        <TextBlock Text="Adapterbezeichnung" TextWrapping="Wrap" />
                        <TextBox Text="{Binding TransferAdapterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                        <TextBlock Text="MAC-Adresse" TextWrapping="Wrap" />
                        <TextBox Text="{Binding TransferMacAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                        <CheckBox Content="DHCP" IsChecked="{Binding Dhcp, Mode=TwoWay}" IsEnabled="{Binding CanUseDhcp}" Margin="0,0,0,8" />
                        <TextBlock Text="Statische IPv4-Adresse" TextWrapping="Wrap" />
                        <TextBox Text="{Binding TransferIpv4, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelectIpv4}" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding Ipv4Hint}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Bemerkung" Margin="0,10,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding TransferRemark, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="34" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoAdaptersTextBlock" Margin="0,12,0,0" Foreground="{DynamicResource ErrorTextBrush}" Text="Es stehen keine Netzwerkadapter zur Auswahl." Visibility="Collapsed" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="DeviceCreationStatusTextBlock" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" />
        <Border x:Name="CreatedDeviceIdBorder" Margin="0,12,0,0" Padding="12" Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="TANSS-System:" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
              <Hyperlink x:Name="CreatedDeviceHyperlink" RequestNavigate="CreatedDeviceHyperlink_OnRequestNavigate">
                <Run x:Name="CreatedDeviceLinkRun" />
              </Hyperlink>
            </TextBlock>
            <Button Grid.Column="2" Width="115" Height="32" Margin="10,0,0,0" Content="Link kopieren" Click="CopyCreatedDeviceLinkButton_OnClick" />
          </Grid>
        </Border>
        <Border Margin="0,14,0,0" Padding="16" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" Background="{DynamicResource InfoBackgroundBrush}">
          <Expander x:Name="TransferPreviewExpander" IsExpanded="False">
            <Expander.Header>
              <TextBlock Text="Optionale JSON-/Übertragungsvorschau" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Zeigt die serverseitig geprüfte Feldzuordnung und die geplante JSON-Nutzlast. Es wird dabei nichts gespeichert." />
                <Button x:Name="CreateTransferPreviewButton" Grid.Column="1" Width="205" Height="34" Margin="16,0,0,0" Content="Optionale Vorschau erstellen" Click="CreateTransferPreviewButton_OnClick" />
              </Grid>
              <TextBlock x:Name="TransferPreviewStatusTextBlock" Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              <TextBox x:Name="TransferPreviewTextBox" Margin="0,10,0,0" MinHeight="210" Padding="10" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Visibility="Collapsed" />
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Margin="0,12,0,0" Padding="16" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" Grid.Row="3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Ausgewählte Daten nach TANSS übertragen" />
        <Button x:Name="CreateDeviceButton" Grid.Column="1" Width="210" Height="36" Margin="16,0,0,0" Content="System nach TANSS übertragen" Click="CreateDeviceButton_OnClick" />
      </Grid>
    </Border>
  </Grid>
</Window>