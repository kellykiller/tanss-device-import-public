<Window x:Class="TanssSystemCapture.Client.ExistingDeviceActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorhandenes TANSS-System"
        Width="650"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Diese Seriennummer ist beim ausgewählten Kunden bereits vorhanden."
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DeviceTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0"
                       Text="Wie soll mit dem vorhandenen Eintrag verfahren werden?"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <Button Height="42"
                    Margin="0,0,0,8"
                    Content="Nur fehlende Werte ergänzen"
                    Click="SupplementButton_OnClick" />
            <Button Height="42"
                    Margin="0,0,0,8"
                    Content="Ausgewählte Werte überschreiben"
                    Click="OverwriteButton_OnClick" />
        </StackPanel>

        <Button Grid.Row="2"
                Width="120"
                Height="34"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Content="Abbrechen"
                Click="CancelButton_OnClick" />
    </Grid>
</Window>

